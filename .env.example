# ── Adaptive routing & evidence gating (Dimension 2) ─────────────────────────
# All optional; the values below are the defaults.

# Set to false to restore the pre-Dimension-2 retrieval path and response shape.
# ADAPTIVE_ROUTING_ENABLED=true

# How the single retry rewrites a weak-evidence query: heuristic (offline) | llm (one Groq call)
# ADAPTIVE_REFORMULATION_MODE=heuristic

# Router: word count treated as "complex", and max sub-queries per retrieval cycle.
# ADAPTIVE_LONG_QUERY_WORDS=35
# ADAPTIVE_MAX_SUBQUERIES=4

# Evidence thresholds. Cohere rerank scores are ranking signals, NOT probabilities.
# The default min top score is an UNCALIBRATED placeholder — calibrate it on the
# Dimension 1 benchmark before relying on refusals.
# ADAPTIVE_EVIDENCE_TOP_K=3
# ADAPTIVE_EVIDENCE_MIN_TOP_SCORE=0.05
# ADAPTIVE_EVIDENCE_MIN_MEAN_SCORE=
# When Cohere is unavailable scores are synthetic and are NOT judged. true = answer as before, false = refuse.
# ADAPTIVE_EVIDENCE_FAIL_OPEN_WHEN_UNSCORED=true

# ── Security & adversarial guardrails (Dimension 3) ──────────────────────────
# All optional; the values below are the defaults. See docs/security.md.

# Set to false to restore the exact pre-Dimension-3 behavior and response shape.
# SECURITY_GUARDRAILS_ENABLED=true

# Switch individual layers off (input guard, retrieved-text sanitizer, prompt hardening, output guard).
# SECURITY_INPUT_GUARD=true
# SECURITY_CONTEXT_SANITIZER=true
# SECURITY_PROMPT_HARDENING=true
# SECURITY_OUTPUT_GUARD=true

# Rule points needed to flag a text (2 = one high-confidence rule, or two weak signals).
# SECURITY_BLOCK_THRESHOLD=2

# Optional honeytoken: planted in the system prompt; any answer containing it is blocked.
# SECURITY_CANARY=

# ── Performance & cost measurement (D5-Lite) ─────────────────────────────────
# All optional. See docs/performance.md. Cost is an ESTIMATE, not billing data.

# true = always add the `performance` block to /query responses. Default: only
# when the request sets include_performance=true.
# PERFORMANCE_METADATA_ENABLED=false

# Price per 1M tokens (both or neither). Overrides config/llm_pricing.json.
# LLM_PRICE_INPUT_PER_1M=
# LLM_PRICE_OUTPUT_PER_1M=
# LLM_PRICE_CURRENCY=USD
# LLM_PRICING_FILE=config/llm_pricing.json
